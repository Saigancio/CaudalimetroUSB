# Dispara exportación CSV al conectar cualquier dispositivo de almacenamiento USB
# Arch Linux ARM — Orange Pi Zero 3
#
# El script recibe el nombre del dispositivo (ej: /dev/sda1), lo monta en
# /mnt/caudalimetro-usb, exporta el CSV y lo desmonta. Corre como root para
# poder montar sin depender de udisks2 ni del mount namespace del usuario.

ACTION=="add", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{ID_FS_TYPE}!="", \
    RUN+="/bin/systemd-run --no-block --unit=caudalimetro-export \
          /opt/caudalimetro/venv/bin/python /opt/caudalimetro/exportar.py $env{DEVNAME}"
